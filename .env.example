# ── Data backend ────────────────────────────────────────────────────────────────
# supabase (production) | local (dev/tests only: JSON file in LOCAL_DATA_DIR, no login, refused on Vercel)
DATA_BACKEND=supabase
LOCAL_DATA_DIR=.data

# ── Supabase (Project Settings → API) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon"/"publishable" key. It's safe in the browser because RLS protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in (lower-case).
ALLOWED_EMAIL=you@example.com

# ── AI ──────────────────────────────────────────────────────────────────────────
# anthropic | mock (fixture responses, no key needed, zero cost)
AI_PROVIDER=anthropic
# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Model for all AI tasks. See SETUP_FOR_ME.md for cost/latency trade-offs.
AI_MODEL=claude-opus-5-5
# low | medium | high — lower is faster and cheaper.
AI_EFFORT=low
# Server-side refusal fallback (beta). Set to "off" to disable.
AI_FALLBACKS=default

# ── Optional ────────────────────────────────────────────────────────────────────
# off = skip in-browser background removal (always use the original photo)
NEXT_PUBLIC_BG_REMOVAL=on
# Artificial delay for the mock AI provider (ms), to see loading states in dev.
MOCK_AI_LATENCY_MS=0
